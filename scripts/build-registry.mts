/**
 * Registry build script.
 *
 * 1. Validates `registry.json` (every referenced file must exist).
 * 2. Generates `registry/__index__.tsx` (+ `__names__.ts`), a map of every demo in
 *    `registry/examples/*.tsx` to a lazily-loaded React component. The docs
 *    previewer and the `/preview/[name]` iframe route read from this map.
 * 3. Runs `shadcn build` to emit installable JSON into `public/r/`.
 *
 * Usage:
 *   pnpm registry:build            # steps 1–3
 *   pnpm registry:index            # steps 1–2 only (fast; used by `pnpm dev`)
 */
import { execSync } from 'node:child_process';
import { existsSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';

const root = process.cwd();
const indexOnly = process.argv.includes('--index-only');

type Manifest = { items: { name: string; files?: { path: string }[] }[] };

const manifestPath = path.join(root, 'registry.json');
const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as Manifest;

// 1. Validate ----------------------------------------------------------------
const problems: string[] = [];
const seen = new Set<string>();
for (const item of manifest.items) {
  if (seen.has(item.name)) problems.push(`Duplicate item name "${item.name}"`);
  seen.add(item.name);
  for (const file of item.files ?? []) {
    if (!existsSync(path.join(root, file.path))) {
      problems.push(`Item "${item.name}" references a missing file: ${file.path}`);
    }
  }
}
if (problems.length) {
  console.error('registry.json has problems:\n- ' + problems.join('\n- '));
  process.exit(1);
}

// 2. Generate the demo index ---------------------------------------------------
const examplesDir = path.join(root, 'registry', 'examples');
const examples = existsSync(examplesDir)
  ? readdirSync(examplesDir)
      .filter((file) => /\.tsx$/.test(file) && !file.startsWith('_'))
      .map((file) => file.replace(/\.tsx$/, ''))
      .sort()
  : [];

const entries = examples
  .map(
    (name) => `  '${name}': {
    name: '${name}',
    path: 'registry/examples/${name}.tsx',
    component: React.lazy(() =>
      import('@/registry/examples/${name}').then((mod) => ({
        default: (mod.default ?? Object.values(mod)[0]) as React.ComponentType,
      })),
    ),
  },`,
  )
  .join('\n');

const indexSource = `'use client';
// THIS FILE IS GENERATED by scripts/build-registry.mts. Do not edit.
// Run \`pnpm registry:index\` after adding or removing a demo in registry/examples.
// It is a client module so demos can be any kind of component and pass functions freely.
import * as React from 'react';

export type DemoEntry = {
  name: string;
  path: string;
  component: React.LazyExoticComponent<React.ComponentType>;
};

export const Index: Record<string, DemoEntry> = {
${entries}
};
`;

const namesSource = `// THIS FILE IS GENERATED by scripts/build-registry.mts. Do not edit.
// Server-safe list of demo names (the index itself is a client module).
export const demoNames = ${JSON.stringify(examples, null, 2)} as const;

export type DemoName = (typeof demoNames)[number];
`;

function writeIfChanged(file: string, content: string) {
  const previous = existsSync(file) ? readFileSync(file, 'utf8') : '';
  if (previous === content) return false;
  writeFileSync(file, content);
  return true;
}

const changedIndex = writeIfChanged(path.join(root, 'registry', '__index__.tsx'), indexSource);
const changedNames = writeIfChanged(path.join(root, 'registry', '__names__.ts'), namesSource);
console.log(
  `✔ registry/__index__.tsx + __names__.ts ${changedIndex || changedNames ? 'written' : 'up to date'} (${examples.length} demo${examples.length === 1 ? '' : 's'})`,
);

// 3. shadcn build --------------------------------------------------------------
if (!indexOnly) {
  console.log('▸ Building registry JSON with shadcn…');
  execSync('pnpm exec shadcn build registry.json --output ./public/r', { stdio: 'inherit', cwd: root });
}
