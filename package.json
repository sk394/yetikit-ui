{
  "name": "yetikit-ui",
  "version": "0.1.0",
  "private": true,
  "description": "YetiKit UI: a personal shadcn (Base UI) component registry with docs and responsive demos.",
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/build-registry.mts --index-only",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:build": "tsx scripts/build-registry.mts",
    "registry:index": "tsx scripts/build-registry.mts --index-only",
    "new:component": "tsx scripts/new-component.mts",
    "typecheck": "pnpm registry:index && next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.10",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
